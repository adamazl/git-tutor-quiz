# Firebase config for the optional "create account" feature.
# Copy this file to .env.local and fill in values from your Firebase project's
# web app settings (Project settings -> General -> Your apps).
#
# Without these, the app still works fully for anonymous use (progress saves
# to this browser only) — account creation will just show an error.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
